{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EZApply",
  "version": "0.1.0",
  "identifier": "com.ezapply.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd --prefix ../frontend run dev -- --host 127.0.0.1 --port 1420 --strictPort",
    "beforeBuildCommand": "npm.cmd --prefix ../frontend run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EZApply",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 800,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
